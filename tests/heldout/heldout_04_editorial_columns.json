      {"id": "headline", "type": "text", "x": 60, "y": 110, "width": 880, "height": 170, "z_index": 2, "content": "Light, Bottled. A Summer Story.", "font_family": "Solstice Serif", "font_size": 64, "color": "rgba(34,30,28,1)", "font_weight": "bold", "style_runs": [{"start": 7, "end": 15, "color": "rgba(232,106,58,1)", "font_weight": "regular", "font_style": "italic"}, {"start": 18, "end": 24, "color": "rgba(240,178,66,1)"}]},
