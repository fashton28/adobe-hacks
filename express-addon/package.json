{
    "name": "chameleon-express-addon",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Adobe Express add-on panel for the CHAMELEON layout adaptation engine (thin client of the local webapp backend).",
    "license": "UNLICENSED",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "clean": "ccweb-add-on-scripts clean",
        "build": "ccweb-add-on-scripts build --use webpack",
        "start": "ccweb-add-on-scripts start --use webpack",
        "package": "ccweb-add-on-scripts package --use webpack",
        "test": "node --test \"test/*.test.mjs\"",
        "lint": "eslint .",
        "check": "npm run lint && npm test && npm run build"
    },
    "keywords": [
        "Adobe",
        "Creative Cloud Web",
        "Add-on",
        "panel"
    ],
    "dependencies": {
        "@spectrum-web-components/action-button": "1.7.0",
        "@spectrum-web-components/button": "1.7.0",
        "@spectrum-web-components/divider": "1.7.0",
        "@spectrum-web-components/field-label": "1.7.0",
        "@spectrum-web-components/help-text": "1.7.0",
        "@spectrum-web-components/menu": "1.7.0",
        "@spectrum-web-components/picker": "1.7.0",
        "@spectrum-web-components/progress-circle": "1.7.0",
        "@spectrum-web-components/status-light": "1.7.0",
        "@spectrum-web-components/textfield": "1.7.0",
        "@spectrum-web-components/theme": "1.7.0",
        "lit": "3.3.3"
    },
    "devDependencies": {
        "@adobe/ccweb-add-on-scripts": "^3.11.0",
        "@babel/plugin-transform-class-properties": "7.24.1",
        "@eslint/js": "^10.0.1",
        "@types/adobe__ccweb-add-on-sdk": "^1.3.0",
        "babel-loader": "9.1.3",
        "copy-webpack-plugin": "11.0.0",
        "css-loader": "6.8.1",
        "eslint": "^10.14.0",
        "globals": "^17.13.0",
        "html-webpack-plugin": "5.5.3",
        "style-loader": "3.3.3",
        "webpack": "5.98.0",
        "webpack-cli": "6.0.1"
    }
}
